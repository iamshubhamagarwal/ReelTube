# Caddy gets and renews a Let's Encrypt certificate for $DOMAIN automatically.
{$DOMAIN} {
	encode zstd gzip

	reverse_proxy app:8000 {
		# Send Server-Sent Events (progress) to the browser immediately.
		flush_interval -1
	}

	# Uploads are tiny (JSON, admin cookies.txt); reject anything bigger.
	request_body {
		max_size 2MB
	}
}
