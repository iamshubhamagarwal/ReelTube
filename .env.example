# Copy to .env and edit. Every value is optional; defaults are shown.

# Your domain (only used by the Caddy HTTPS proxy: docker compose --profile https)
DOMAIN=clips.example.com

# Enables /api/admin/* endpoints. Use a long random string, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Jobs
MAX_CONCURRENT_JOBS=2
MAX_QUEUED_JOBS=20
MAX_ACTIVE_JOBS_PER_IP=10
JOB_TIMEOUT_SECONDS=1800

# Multi-clip / batch
MAX_CLIPS_PER_JOB=20
MAX_TOTAL_CLIP_SECONDS=3600
MAX_BATCH_ITEMS=10

# Instagram: retries with backoff (5s, 15s, 45s) when rate-limited
INSTAGRAM_RETRIES=3

# Limits
MAX_DURATION_SECONDS=10800
MAX_FILESIZE_MB=2048
MAX_QUALITY=2160
FILE_TTL_SECONDS=3600

# Rate limits per IP
RATE_INFO_PER_MINUTE=30
RATE_DOWNLOADS_PER_HOUR=30

# Prefer H.264/AAC (max 1080p) for maximum player compatibility
PREFER_H264=false

# JS runtime for yt-dlp. Leave empty in Docker (Deno is installed).
# Set to "node" when running locally with only Node.js installed.
YTDLP_JS_RUNTIMES=
